<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yorha.ubersicht-watchdog</string>

  <!-- Runs from ~/.config/yorha/bin, NOT the repo: launchd has no TCC access to
       ~/Documents and would fail with "Operation not permitted" on every fire. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>HOME_PATH/.config/yorha/bin/ubersicht-watchdog.sh</string>
  </array>

  <!-- Health check every 60s. RunAtLoad starts Übersicht at login, which is what
       makes the desktop layer come back after a reboot. -->
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>

  <!-- Deliberately NOT KeepAlive on this job: it is a short-lived check, not a
       daemon. KeepAlive would respawn it in a tight loop the instant it exits.
       The KeepAlive *behaviour* the user wanted lives inside the script, which
       restarts Übersicht only when it is genuinely unhealthy. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>

  <key>StandardErrorPath</key>
  <string>HOME_PATH/.config/yorha/cache/watchdog.stderr.log</string>
</dict>
</plist>
