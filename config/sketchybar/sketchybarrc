#!/usr/bin/env bash
BONE=0xffcac5b0
INK=0xff4a4741
ALERT=0xffbb3b36

if [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)" = Dark ]; then
  MODE=dark
  TEXT=0xffd8d4c4; BRAND=0xffbc9a5a
  CREST="$HOME/.config/yorha/appearance/yorha-icon-dark.png"
else
  MODE=light
  TEXT=0xff4a4741; BRAND=0xff4a4741
  CREST="$HOME/.config/yorha/appearance/yorha-icon-light.png"
fi

# Transparent bar: no fill, no border, so the items float directly on the
# wallpaper. 0x00000000 is fully transparent (the alpha is the leading byte).
# Contrast still holds — ink labels on the parchment wallpaper.
#
# DO NOT park the bar off-screen here. The bar was once defined with
# y_offset=-36, relying on the entrance animation at the end of this file to
# slide it in — and `--animate ... --bar y_offset` silently no-ops after a
# reload, which stranded the entire bar invisible off-screen. Visibility must
# never depend on an animation firing.
sketchybar --bar height=32 position=top padding_left=12 padding_right=12 \
                 color=0x00000000 border_width=0

sketchybar --default label.font="Cascadia Code:Regular:11.0" \
                     icon.font="Cascadia Code NF:Regular:12.0" \
                     label.color=$TEXT icon.color=$TEXT \
                     padding_left=6 padding_right=6

# YoRHa crest, left of the wordmark. The PNG is pre-tinted to INK and rendered
# 31x36 px (2x); scale 0.5 displays it at ~15.5x18 pt inside the 32 pt bar.
# deploy.sh copies it here from assets/ — the repo path itself is under the
# TCC-protected ~/Documents, which launchd services like sketchybar cannot read.
# background.drawing=on is the MASTER gate: the image is a sub-layer of the
# item background, and with the parent off the image silently never renders —
# the item still reserves its width, so it looks like a mysterious gap.
# background.color stays fully transparent so only the crest draws, no box.
#
# FIXED-WIDTH TRAP: with width set, sketchybar pins the item's whole layout
# footprint to that number and IGNORES padding_left/right when placing the next
# item — the wordmark once overlapped this box by 6pt while padding tweaks did
# nothing. The spacing lives INSIDE the width: crest displays ~15.5pt wide,
# centered, so width=22 = ~3.2pt of air each side. Adjust spacing via width only.
sketchybar --add item yorha_icon left \
           --set yorha_icon background.drawing=on \
                            background.color=0x00000000 \
                            background.image="$CREST" \
                            background.image.scale=0.5 \
                            background.image.drawing=on \
                            width=22 padding_left=0 padding_right=0

sketchybar --add item yorha left \
           --set yorha label="YoRHa" label.font="Cascadia Code:Bold:11.0" \
                       label.color=$BRAND padding_left=0

sketchybar --add item clock right \
           --set clock update_freq=10 label.color=$TEXT \
                       script="sketchybar --set clock label=\"\$(date '+%H.%M')\""

# Date, left of the clock. This replaced a CPU readout that could never agree
# with the HUD's "Processor Load": identical formula, but sampled at a different
# instant on a different cadence (15s vs 10s), against a metric that swung
# 21% -> 46% -> 19% across four seconds. Two independent pollers of an
# instantaneous value will always disagree; the fix was to stop showing it twice.
# The date changes once a day, so there is nothing to desync.
sketchybar --add item date right \
           --set date update_freq=60 \
                      script="sketchybar --set date label=\"\$(date '+%a %d %b' | tr '[:lower:]' '[:upper:]')\"" \
                      label.color=$TEXT

sketchybar --update

# Entrance: slide in from above, but ONLY on the first run after boot — /tmp is
# cleared at boot, so the sentinel scopes the ceremony to login. On reloads the
# bar simply appears in place; `--animate --bar` proved unreliable post-reload.
# The unconditional y_offset=0 afterwards is the guarantee: even if the
# animation is dropped entirely, the bar ends up on screen.
ENTRY=/tmp/.yorha_bar_entered
if [ ! -f "$ENTRY" ]; then
  touch "$ENTRY"
  sketchybar --bar y_offset=-36
  sketchybar --animate sin 30 --bar y_offset=0
  sleep 0.7
fi
sketchybar --bar y_offset=0
"$HOME/.config/yorha/bin/apply-appearance.sh" "$MODE" --force >/dev/null 2>&1 || true
